# Serviço systemd do RobotEye.
#
# Instale com `./scripts/setup-raspberry-pi.sh --service`, que substitui os
# marcadores @USER@ e @REPO_DIR@ pelos valores corretos.
#
# Depois:
#   sudo systemctl start roboteye     inicia agora
#   sudo systemctl status roboteye    estado atual
#   journalctl -u roboteye -f         acompanha os logs

[Unit]
Description=RobotEye - face robotica com IA e voz local
After=network-online.target sound.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO_DIR@

# A face precisa de uma sessão gráfica ativa no display local.
Environment=DISPLAY=:0
# %U é o uid do usuário do serviço. Fixar 1000 aqui quebrava em qualquer Pi cujo
# usuário não fosse o primeiro criado — que é o caso sempre que alguém adiciona
# uma conta própria em vez de usar a padrão.
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=ROBOTEYE_FACE_FULLSCREEN=true

# Sem terminal para o chat de texto: roda apenas a face.
ExecStart=@REPO_DIR@/.venv/bin/roboteye face --fullscreen

Restart=on-failure
RestartSec=5

# Aperta um pouco a segurança sem atrapalhar o acesso a áudio e vídeo.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
